{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ce-grandrang",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-21",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "ce-grandrang", "database_id": "69ef2798-8868-4add-9c93-eb31e0b03c42" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ce-grandrang-media" }]
}
